# The Radio needs its band snapshot. A global ignore rule for *.json would
# otherwise leave it out of the repo, and the deployed set would find nothing
# on the dial.
!public/live-band.json

# The F1 archive generator reads its tracked constructor/alias configuration.
!src/data/f1TeamConfig.json

# Curated Commons photo pools back every F1 win with a real image.
!src/data/f1PhotoPools/
!src/data/f1PhotoPools/*.json
